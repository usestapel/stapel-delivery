{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delivery.quote",
  "description": "The orders adjuster (kind=shipping, order 200). Request: the orders adjuster request (SPEC-BRICKS-WAVE \u00a72). Reads context.delivery {method, address | address_id | pickup_point}. Output: {adjustments: [{kind: 'shipping', code: <method code>, label: <method name>, amount: '<decimal string>', line_index: null, meta: {method, kind, carrier, zone, weight_basis, free_reason?, pickup_point?}}], errors: [{code: 'error.<status>.<slug>', field, params}]}. No personal data rides meta.",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "subtotal": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "description": "The acting account id (a guest's own id, or the account), always sent by orders that know it; user_id stays null for a guest. Owner of this brick's rows; absent from older orders payloads."
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "purchasable_type": {
            "type": "string",
            "maxLength": 32
          },
          "purchasable_key": {
            "type": "string",
            "maxLength": 255
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
          },
          "line_total": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
          },
          "attrs": {
            "type": "object",
            "description": "The purchasable resolver's extra scalar fields; delivery reads weight_grams (integer grams) and shippable (false = not shipped)."
          }
        },
        "required": [
          "quantity"
        ],
        "additionalProperties": true
      },
      "maxItems": 100
    },
    "adjustments_so_far": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Earlier adjusters' adjustments; meta.free_shipping=true (optionally narrowed by meta.free_shipping_methods) makes shipping free."
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "delivery": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "maxLength": 32
            },
            "address": {
              "type": "object",
              "description": "Inline recipient address (validated by delivery: name<=120, phone<=32, line1/line2<=200, city<=100, region<=100, postal_code<=20, country ISO alpha-2).",
              "properties": {
                "name": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "line1": {
                  "type": "string"
                },
                "line2": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "postal_code": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "latitude": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "longitude": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            },
            "address_id": {
              "type": [
                "integer",
                "string"
              ],
              "description": "An entry of user_id's address book (accounts only)."
            },
            "pickup_point": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      }
    }
  },
  "required": [
    "currency",
    "subtotal",
    "lines"
  ],
  "additionalProperties": true
}
