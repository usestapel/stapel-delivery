{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delivery.release",
  "description": "Orders checkout hook, release. checkout_failed/orphaned: the reserved intent is released. cancelled: the order's shipment is cancelled if it has not left (pending/packed). Output: {ok: true}. Idempotent.",
  "type": "object",
  "properties": {
    "attempt_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "reason": {
      "type": "string",
      "enum": [
        "checkout_failed",
        "cancelled",
        "orphaned"
      ]
    }
  },
  "required": [
    "attempt_key"
  ],
  "additionalProperties": true
}
