  "components": {
    "schemas": {
      "AddressList": {
        "type": "object",
        "description": "The whole book: bounded by MAX_ADDRESSES, so it is not paginated.",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressResponse"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "minimum": 0,
            "description": "MAX_ADDRESSES."
          }
        },
        "required": [
          "count",
          "items",
          "max"
        ]
      },
      "AddressRequest": {
        "type": "object",
        "description": "A recipient address as checkout and the book accept it.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Recipient name.",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "description": "Recipient phone.",
            "maxLength": 32,
            "pattern": "^\\+?[0-9][0-9 ()\\-.]{2,31}$"
          },
          "line1": {
            "type": "string",
            "maxLength": 200
          },
          "line2": {
            "type": "string",
            "default": "",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "default": "",
            "maxLength": 100
          },
          "postal_code": {
            "oneOf": [
              {
                "type": "string",
                "default": "",
                "maxLength": 20,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 \\-]{0,19}$"
              },
              {
                "type": "string",
                "maxLength": 0
              }
            ]
          },
          "country": {
            "type": "string",
            "description": "ISO 3166 alpha-2.",
            "maxLength": 2,
            "minLength": 2,
            "pattern": "^[A-Za-z]{2}$"
          },
          "latitude": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,3}(?:\\.\\d{0,6})?$",
            "nullable": true
          },
          "longitude": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,3}(?:\\.\\d{0,6})?$",
            "nullable": true
          },
          "label": {
            "type": "string",
            "default": "",
            "description": "Home, Office…",
            "maxLength": 60
          },
          "is_default": {
            "type": "boolean",
            "default": false,
            "description": "Make this the default address."
          }
        },
        "required": [
          "city",
          "country",
          "line1",
          "name",
          "phone"
        ]
      },
      "AddressResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 32
          },
          "line1": {
            "type": "string",
            "maxLength": 200
          },
          "line2": {
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "maxLength": 100
          },
          "postal_code": {
            "type": "string",
            "maxLength": 20
          },
          "country": {
            "type": "string",
            "maxLength": 2
          },
          "latitude": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,3}(?:\\.\\d{0,6})?$",
            "nullable": true
          },
          "longitude": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,3}(?:\\.\\d{0,6})?$",
            "nullable": true
          },
          "is_default": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "city",
          "country",
          "created_at",
          "id",
          "is_default",
          "label",
          "latitude",
          "line1",
          "line2",
          "longitude",
          "name",
          "phone",
          "postal_code",
          "region",
          "updated_at"
        ]
      },
      "CartLineInput": {
        "type": "object",
        "properties": {
          "purchasable_type": {
            "type": "string",
            "default": "",
            "maxLength": 32
          },
          "purchasable_key": {
            "type": "string",
            "default": "",
            "maxLength": 255
          },
          "quantity": {
            "type": "integer",
            "maximum": 999,
            "minimum": 1
          },
          "unit_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
            "nullable": true
          },
          "attrs": {
            "type": "object",
            "additionalProperties": {},
            "description": "The cart line's attrs; weight_grams is read."
          }
        },
        "required": [
          "quantity"
        ]
      },
      "DeliveryMethodList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryMethodResponse"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "DeliveryMethodResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "kind": {
            "$ref": "#/components/schemas/MethodKindEnum"
          },
          "eta_min_days": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "eta_max_days": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        },
        "required": [
          "code",
          "description",
          "eta_max_days",
          "eta_min_days",
          "kind",
          "name"
        ]
      },
      "DeliveryOption": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "kind": {
            "$ref": "#/components/schemas/MethodKindEnum"
          },
          "eta_min_days": {
