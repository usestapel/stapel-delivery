    "/delivery/api/v1/pickup-points/": {
      "get": {
        "operationId": "delivery_pickup_points_list",
        "description": "Enabled pickup points, filterable by method, country and city.\n\n**Permissions:** `AllowAny`",
        "parameters": [
          {
            "in": "query",
            "name": "anchor",
            "schema": {
              "type": "string"
            },
            "description": "Opaque anchor from next_anchor/prev_anchor (exclusive)."
          },
          {
            "in": "query",
            "name": "city",
            "schema": {
              "type": "string"
            },
            "description": "City, case-insensitive."
          },
          {
            "in": "query",
            "name": "country",
            "schema": {
              "type": "string"
            },
            "description": "ISO 3166 alpha-2."
          },
          {
            "in": "query",
            "name": "direction",
            "schema": {
              "type": "string",
              "enum": [
                "next",
                "prev"
              ]
            },
            "description": "Walk direction from the anchor."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "description": "Page size, default 50, max 200."
          },
          {
            "in": "query",
            "name": "method",
            "schema": {
              "type": "string"
            },
            "description": "Method code."
          }
        ],
        "tags": [
          "Delivery"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PickupPointPage"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/delivery/api/v1/shipments/": {
      "get": {
        "operationId": "delivery_shipments_list",
        "description": "My shipments, newest first.\n\n**Permissions:** `IsAuthenticated`",
        "parameters": [
          {
            "in": "query",
            "name": "anchor",
            "schema": {
              "type": "string"
            },
            "description": "Opaque anchor from next_anchor/prev_anchor (exclusive)."
          },
          {
            "in": "query",
            "name": "direction",
            "schema": {
              "type": "string",
              "enum": [
                "next",
                "prev"
              ]
            },
            "description": "Walk direction from the anchor."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "description": "Page size, default 20, max 100."
          },
          {
            "in": "query",
            "name": "order_id",
            "schema": {
              "type": "string"
            },
            "description": "Only the shipment of this order."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "cancelled",
                  "delivered",
                  "packed",
                  "pending",
                  "returned",
                  "shipped"
                ]
              }
            },
            "description": "Filter by status (repeatable)."
          }
        ],
        "tags": [
          "Delivery"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentPage"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/delivery/api/v1/shipments/{shipment_id}/": {
      "get": {
        "operationId": "delivery_shipments_retrieve",
        "description": "Track one of my shipments: status, tracking link, timeline.\n\n**Permissions:** `IsAuthenticated`",
