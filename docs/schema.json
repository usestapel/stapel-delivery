          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressList"
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "delivery_addresses_create",
        "description": "My address book (bounded by MAX_ADDRESSES) and adding to it.\n\n**Permissions:** `IsNotAnonymousUser`",
